{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "dev-oka",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "dev-oka.com",
      "custom_domain": true
    },
    {
      "pattern": "www.dev-oka.com",
      "custom_domain": true
    }
  ]
}
